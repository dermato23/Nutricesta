<?xml version="1.0" encoding="utf-8"?>
<!--
    Política de red: todo el tráfico debe ir por HTTPS.
    La única excepción es 10.0.2.2 (el localhost de la máquina host visto
    desde el emulador de Android), que se usa en desarrollo contra el
    backend local por HTTP.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
