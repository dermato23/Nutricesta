+def safe_float(value, default=0.0):
+    """Convierte a float valores devueltos por la IA sin confiar en su formato."""
+    try:
+        return float(value)
+    except (ValueError, TypeError):
+        return default
+
+def safe_int(value, default=0):
+    try:
+        return int(float(value))
+    except (ValueError, TypeError):
+        return default
